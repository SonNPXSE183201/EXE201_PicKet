# Public hostnames. Create DNS A/AAAA records pointing to the VPS first.
PICKET_LANDING_DOMAIN=picketfinance.com
PICKET_WEB_DOMAIN=app.picketfinance.com
PICKET_API_DOMAIN=api.picketfinance.com
PICKET_LEGACY_WEB_DOMAIN=picket.51-79-207-154.sslip.io
PICKET_LEGACY_API_DOMAIN=api.51-79-207-154.sslip.io
# APP_BASE_URL is derived from PICKET_WEB_DOMAIN by compose.production.yml.
NEXT_PUBLIC_API_URL=https://api.picketfinance.com
ALLOWED_ORIGINS=https://app.picketfinance.com,https://picket.51-79-207-154.sslip.io
ACME_EMAIL=ops@example.com

# Supabase public values. The publishable key is intentionally safe for apps.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase secret for workers and authorized Dart admin operations.
# Never copy this into Next.js public values or Expo.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
ADMIN_TELEMETRY_ENABLED=false
PLAY_REPORTS_BUCKET=
PLAY_VITALS_ENABLED=false
PLAY_FINANCIAL_ENABLED=false
ADMIN_SMTP_PROBE=false
# Pin an immutable image tag when deploying a built admin/PayOS worker.
PICKET_ADMIN_WORKER_IMAGE=picket-admin-worker:local

# Generate with: openssl rand -hex 32
OCR_PROVIDER_TOKEN=replace_with_at_least_32_random_characters
OCR_WORKER_ID=picket-vps-worker-01
OCR_POLL_INTERVAL_MS=2000
OCR_CPU_THREADS=2

# Enable only after configuring Play products, license testers and RTDN.
# This flag opens purchases for all authenticated users; it is not a tester allowlist.
GOOGLE_PLAY_BILLING_ENABLED=false
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ACCOUNT_NUMBER=
PAYOS_WORKER_SECRET=
QUICK_LOGIN_ENABLED=false
# Backend-only 32-byte random key, base64 encoded; never NEXT_PUBLIC_/EXPO_PUBLIC_.
QUICK_LOGIN_ENCRYPTION_KEY=

# Keep 1 for production. Use 0 only for a quick image-build check; the model
# will then be downloaded when the OCR container starts for the first time.
OCR_PRELOAD_MODELS=1
# Optional immutable images published by .github/workflows/publish-images.yml.
# Keep these commented to build locally on the VPS instead.
# PICKET_WEB_IMAGE=ghcr.io/your-github-owner/picket-web:v1.0.0
# PICKET_API_IMAGE=ghcr.io/your-github-owner/picket-api:v1.0.0
# PICKET_OCR_WORKER_IMAGE=ghcr.io/your-github-owner/picket-ocr-worker:v1.0.0
# PICKET_OCR_PROVIDER_IMAGE=ghcr.io/your-github-owner/picket-ocr-provider:v1.0.0

# Optional web Turnstile: runtime values; no NEXT_PUBLIC prefix or image rebuild.
# Set BOTH to enable on login, register, forgot-password and email OTP forms.
# Register the web hostname in Cloudflare Turnstile. Missing either disables it.
# The site key is passed to forms; the secret stays on the server.
# Recreate/restart the web container after changing its environment.
TURNSTILE_SITE_KEY=
GOOGLE_WEB_CLIENT_ID=18042168468-kpse8gg1dhg6eisu1tjd63iaucourku1.apps.googleusercontent.com
TURNSTILE_SECRET_KEY=
