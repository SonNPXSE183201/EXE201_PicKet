NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_BASE_URL=http://localhost:3000

# Optional web Turnstile: runtime values; no NEXT_PUBLIC prefix or image rebuild.
# Set BOTH to enable on login, register, forgot-password and email OTP forms.
# Register the web hostname in Cloudflare Turnstile. Missing either disables it.
# The site key is passed to forms; the secret stays on the server.
# Recreate/restart the web container after changing its environment.
TURNSTILE_SITE_KEY=
GOOGLE_WEB_CLIENT_ID=18042168468-kpse8gg1dhg6eisu1tjd63iaucourku1.apps.googleusercontent.com
TURNSTILE_SECRET_KEY=
