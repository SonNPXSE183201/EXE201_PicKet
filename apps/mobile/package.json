{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@picket/api-client": "file:../../packages/api-client",
    "@picket/design-tokens": "file:../../packages/design-tokens",
    "@picket/domain": "file:../../packages/domain-ts",
