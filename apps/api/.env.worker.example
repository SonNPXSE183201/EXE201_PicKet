# Worker-only configuration. Never expose these values to Expo, Next.js, or the
# public Dart Frog process.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
OCR_PROVIDER_URL=https://your-private-pp-ocr-service.example/predict
OCR_PROVIDER_TOKEN=replace_with_provider_token
# Only enable this when OCR_PROVIDER_URL is an internal Docker/private-network
# HTTP address such as http://ocr-provider:8000/predict.
OCR_ALLOW_INSECURE_PRIVATE_URL=false
OCR_WORKER_ID=picket-ocr-worker-01
OCR_POLL_INTERVAL_MS=2000
