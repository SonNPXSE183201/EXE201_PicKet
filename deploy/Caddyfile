	email {$ACME_EMAIL}
}

{$PICKET_WEB_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	@landing path / /launch-assets/* /downloads/* /release.json
	handle @landing {
		root * /srv/picket-landing
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		@apk path /downloads/*.apk
		header @apk {
			Content-Type application/vnd.android.package-archive
			Content-Disposition attachment
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

{$PICKET_API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy api:8080
}
