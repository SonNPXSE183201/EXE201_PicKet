{
  "expo": {
    "name": "Picket",
    "slug": "picket",
    "scheme": "com.picket.mobile",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/picket-logo.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.picket.mobile",
      "versionCode": 28,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8ED",
        "foregroundImage": "./assets/picket-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/with-android-release-signing",
      "./plugins/with-play-store-build",
      "./plugins/with-safe-launcher-icon",
      "./plugins/with-network-pool-guard",
      "./plugins/with-current-activity-intent",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PicketNunito",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/nunito-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/nunito-600.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/nunito-700.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/nunito-800.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Picket dùng camera để quét hóa đơn.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Picket dùng camera để chụp hóa đơn.",
          "photosPermission": "Cho phép Picket truy cập ảnh để chọn hóa đơn.",
          "microphonePermission": false
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/picket-logo.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8ED"
        }
      ],
      "expo-sharing",
      "expo-iap",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
