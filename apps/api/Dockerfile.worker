# syntax=docker/dockerfile:1
FROM dart:3.12.0 AS build

WORKDIR /src
COPY pubspec.yaml pubspec.lock ./
RUN dart pub get
COPY bin ./bin
COPY lib ./lib
RUN mkdir -p /out \
    && dart compile exe bin/ocr_worker.dart -o /out/picket-ocr-worker

FROM scratch AS runtime
COPY --from=build /runtime/ /
COPY --from=build /out/picket-ocr-worker /app/picket-ocr-worker

WORKDIR /
USER 65532:65532
ENTRYPOINT ["/app/picket-ocr-worker"]
